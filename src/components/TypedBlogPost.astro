---
/* src/components/TypedBlogPost.astro */
import { Formatter } from "@utils/formatter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const frontmatter = post.data;
---

<div class="lg:flex">
  <Image
    class="object-cover w-full h-56 rounded-lg lg:w-64"
    src={frontmatter.image}
    alt={frontmatter.title}
    width={500}
    height={500}
    quality="low"
    loading="lazy"
    transition:name=`${frontmatter.title}-image`
  />

  <div class="flex flex-col justify-between py-6 lg:mx-6">
    <a
      href={`/posts/${post.id}`}
      class="text-xl font-semibold text-gray-800 cursor-pointer hover:underline dark:text-white"
    >
      {frontmatter.title}
    </a>

    <span class="text-sm text-gray-500 dark:text-gray-300"
      >On: {Formatter.formatDate(frontmatter.date.toISOString())}
    </span>
  </div>
</div>
