---
import CardAuthors from "@components/CardAuthors.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "src/config/siteConfig";
import MainLayout from "src/layouts/MainLayout.astro";

const authors = await getCollection("author");
---

<MainLayout title="Listado de autores">
  <section class="container px-6 py-10 mx-auto">
    <h1 class="text-3xl text-white">
      {siteConfig.title}
    </h1>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-2 gap-2">
    <!-- Authir card -->
    {authors.map((author) => <CardAuthors author={author} />)}
  </section>
</MainLayout>
